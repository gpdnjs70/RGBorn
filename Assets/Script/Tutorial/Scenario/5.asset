  - talkerType: 0
    talkerName: "\uC218\uC2B5\uC0AC\uC81C"
    context: "\uC800\uD76C \uAD50\uB2E8\uC5D0\uC11C \uC740\uC778\uB2D8\uC744 \uB178\uB9B4\uC9C0\uB3C4
