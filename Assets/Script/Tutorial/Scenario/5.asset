  - talkerType: 0
    talkerName: "\uC218\uC2B5\uC0AC\uC81C"
    context: "\uC88B\uC740 \uAC74 \uC544\uB2C8\uC9C0\uB9CC \uC5C6\uB294 \uAC83\uBCF4\uB2E8
