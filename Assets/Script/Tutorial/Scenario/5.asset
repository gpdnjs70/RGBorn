    customOffset: {x: 0, y: 4, z: 0}
  - talkerType: 0
    talkerName: "\uC218\uC2B5\uC0AC\uC81C"
    context: "\uADF8\uB7EC\uB2C8\uAE4C, \uC774\uAC74 \uC81C\uAC00 \uC785\uACE0 \uC788\uB358
