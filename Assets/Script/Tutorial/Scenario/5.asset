  - talkerType: 1
    talkerName: player
    context: "\u2026\u201C\uC0C9\u201D\uC774\uC694?"
    portrait: {fileID: 21300000, guid: 3f8801288d77c1c479accccaf8d9369b, type: 3}
    customOffset: {x: 0, y: 4, z: 0}
  - talkerType: 0
    talkerName: "\uC218\uC2B5\uC0AC\uC81C"
    context: "\uC774\uAC74 \uC800\uD76C \uAD50\uB2E8 \uC0AC\uC81C\uC5D0\uAC8C\uB9CC
      \uC54C\uC74C\uC54C\uC74C \uC54C\uB824\uC9C4 \uB0B4\uC6A9\uC778\uB370,"
    portrait: {fileID: 21300000, guid: 3f3c7f35a186b41498edc6d1f47191ad, type: 3}
    customOffset: {x: 0, y: 4, z: 0}
  - talkerType: 0
    talkerName: "\uC218\uC2B5\uC0AC\uC81C"
    context: "\u201C\uC138\uC0C1\uC5D0 \u2018\uC0C9\u2019\uC744 \uB418\uB3CC\uB9B4
      \uC544\uC774\uAC00 \uB098\uD0C0\uB0A0 \uAC83\uC774\uB2E4.\u201D\uB77C\uB294
      \uC608\uC5B8\uC774 \uC788\uC5B4\uC694."
    portrait: {fileID: 21300000, guid: 3f3c7f35a186b41498edc6d1f47191ad, type: 3}
    customOffset: {x: 0, y: 4, z: 0}
  - talkerType: 0
    talkerName: "\uC218\uC2B5\uC0AC\uC81C"
    context: "\uC740\uC778\uB2D8\uC774 \uADF8 \uC608\uC5B8 \uC18D\uC758 \uC874\uC7AC\uC778
