--- !u!114 &1161781219
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1161781217}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 203d3de3967b8904486dd8a62241059a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  imageDisplay: {fileID: 2070562779}
  textDisplay: {fileID: 1150667007}
  cutsceneScenes:
  - illustration: {fileID: 21300000, guid: 906e0dc5584dccb4f8be796d73786bbe, type: 3}
    dialogue: "\uBA87 \uB144 \uC804, \uC791\uACE0 \uC870\uC6A9\uD55C \uB9C8\uC744\uC5D0
      \uD55C \uAC00\uC871\uC774 \uC0B4\uACE0 \uC788\uC5C8\uB2E4.\r\n\uC5BC\uB9C8
      \uC804 \uD0DC\uC5B4\uB09C \uC544\uC774\uB85C \uC778\uD574 \r\n\uC9D1\uC548\uC5D0\uB294
      \uC6C3\uC74C\uC774 \uB04A\uC774\uC9C0 \uC54A\uC558\uB2E4."
    displayTime: 4.5
  - illustration: {fileID: 21300000, guid: 64767daa34d9ce84887a38cffc337785, type: 3}
    dialogue: "\uADF8\uB7EC\uB2E4 \uC5B4\uB290 \uB0A0,\r\n\uD070 \uC544\uC774\uB294
      \uB3D9\uC0DD\uC758 \uD589\uBCF5\uC744 \uBE4C\uC5B4\uC8FC\uAE30 \uC704\uD574\r\n\uB9C8\uC744
      \uADFC\uCC98 \uC2E0\uC804\uC5D0 \uB2E4\uB140\uC624\uACA0\uB2E4\uACE0 \uD588\uB2E4."
    displayTime: 4.5
  - illustration: {fileID: 21300000, guid: 64767daa34d9ce84887a38cffc337785, type: 3}
    dialogue: "\uD558\uC9C0\uB9CC\u2014\r\n\uADF8\uB0A0 \uC774\uD6C4\uB85C \uC544\uC774\uB294
      \uC9D1\uC5D0 \uB3CC\uC544\uC624\uC9C0 \uC54A\uC558\uB2E4."
    displayTime: 4
  - illustration: {fileID: 21300000, guid: f13cc5bf173b5ba43808f37b689c2b6d, type: 3}
    dialogue: "\uC5B4\uBA38\uB2C8\uB294 \uC544\uC774\uB97C \uCC3E\uC544\r\n\uC232\uC744
      \uB4A4\uC9C0\uACE0, \uAE38\uC744 \uB530\uB77C\uAC00\uBA70 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C
      \uBB3B\uACE0 \uB610 \uBB3C\uC5C8\uB2E4."
    displayTime: 4
  - illustration: {fileID: 21300000, guid: f13cc5bf173b5ba43808f37b689c2b6d, type: 3}
    dialogue: "\uADF8\uB7EC\uB098 \uADF8 \uC5B4\uB514\uC5D0\uC11C\uB3C4 \uC544\uC774\uC758
      \uD754\uC801\uC744 \uCC3E\uC744 \uC218 \uC5C6\uC5C8\uB2E4.\r\n\uC5B4\uBA38\uB2C8\uC758
      \uBC1C\uAC78\uC74C\uC740 \uC810\uC810 \uBB34\uAC70\uC6CC\uC838 \uAC14\uB2E4."
    displayTime: 4
  - illustration: {fileID: 21300000, guid: 37b34510fe531704d9223422714aef74, type: 3}
    dialogue: "\uADF8\uB7EC\uB358 \uC5B4\uB290 \uB0A0, \uC2E0\uC804\uC5D0\uC11C \uC0AC\uB78C\uB4E4\uC774
      \uCC3E\uC544\uC654\uB2E4.\r\n\uADF8\uB4E4\uC740 \uC791\uC740 \uC0C1\uC790 \uD558\uB098\uB97C
      \uB4E4\uACE0 \uC640 \uB9D0\uC744 \uC804\uD588\uB2E4."
    displayTime: 4
  - illustration: {fileID: 21300000, guid: c8686dda81d3d26448b350c390ca6c42, type: 3}
    dialogue: "\uADF8\uB0A0, \uC2E0\uC804\uC5D0\uC11C\uB294 \uD070 \uD589\uC0AC\uAC00
      \uC788\uC5C8\uACE0\r\n\uC544\uC774\uB3C4 \uADF8 \uC790\uB9AC\uC5D0 \uC788\uC5C8\uB2E4\uACE0
      \uD588\uB2E4."
    displayTime: 4
  - illustration: {fileID: 21300000, guid: c8686dda81d3d26448b350c390ca6c42, type: 3}
    dialogue: "\uADF8\uB9AC\uACE0 \uC544\uC774\uAC00 \uC8FC\uAD50\uB97C \uB9C8\uC8FC\uD55C
      \uC21C\uAC04,\r\n\uAC10\uD788 \u2018\uC0C9\u2019\uC744 \uD0D0\uD588\uACE0,
      \uADF8 \uC8C4\uB85C \uC800\uC8FC\uB97C \uBC1B\uC558\uB2E4\uBA70\u2014"
    displayTime: 4
  - illustration: {fileID: 21300000, guid: 467134e47c6c9af4db3b409d48634a76, type: 3}
    dialogue: "\uC544\uC774\uB294 \uACB0\uAD6D \uAD34\uBB3C\uC774 \uB418\uC5B4\uBC84\uB838\uB2E4\uACE0
      \uD588\uB2E4."
    displayTime: 3
  - illustration: {fileID: 21300000, guid: d3121324c973bb3489d37a7aeadcb3bb, type: 3}
    dialogue: "\uADF8\uB798\uC11C \uC5B4\uCA54 \uC218 \uC5C6\uC5C8\uB2E4\uACE0.\r\n\uADF8\uB4E4\uC740
      \uADF8\uB807\uAC8C \uB9D0\uD558\uBA70 \uC0C1\uC790\uB97C \uB450\uACE0 \uB3CC\uC544\uAC14\uB2E4."
    displayTime: 4
  - illustration: {fileID: 21300000, guid: d3121324c973bb3489d37a7aeadcb3bb, type: 3}
    dialogue: "\uC5B4\uBA38\uB2C8\uB294 \uD55C\uCC38\uC744 \uADF8 \uC790\uB9AC\uC5D0
      \uC11C \uC788\uC5C8\uB2E4.\r\n\uC0C1\uC790\uB97C \uC5F4\uC9C0\uB3C4 \uBABB\uD55C
      \uCC44 \uADF8\uC800 \uC190\uC5D0 \uC950\uACE0\uB9CC \uC788\uC5C8\uB2E4."
    displayTime: 4
  - illustration: {fileID: 21300000, guid: 2d53826415432e84caf627240dff068c, type: 3}
    dialogue: "\uADF8\uB0A0 \uC774\uD6C4, \uC5B4\uBA38\uB2C8\uB294 \uB354 \uC774\uC0C1
      \uC6C3\uC9C0 \uC54A\uC558\uB2E4."
    displayTime: 3
  - illustration: {fileID: 21300000, guid: 2d53826415432e84caf627240dff068c, type: 3}
    dialogue: "\u2018\uC0C9\u2019\uC744 \uC99D\uC624\uD588\uACE0, \uC2E0\uC804\uC744
      \uC6D0\uB9DD\uD588\uC73C\uBA70, \r\n\uADF8\uC640 \uAD00\uB828\uB41C \uC774\uC57C\uAE30\uB294
      \uC785\uC5D0 \uC62C\uB9AC\uC9C0\uB3C4 \uC54A\uC558\uB2E4.\r\n\uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC740
      \uADF8\uB7F0 \uC5B4\uBA38\uB2C8\uB97C \uBC30\uCC99\uD558\uACE0 \uC678\uBA74\uD588\uB2E4."
    displayTime: 4.5
  - illustration: {fileID: 21300000, guid: 345e1fa64f30bfa4594a7343b01a5ce4, type: 3}
    dialogue: "\uADF8\uB807\uAC8C \uC9C0\uB0B4\uB358 \uC5B4\uB290 \uB0A0, \uC5B4\uBA38\uB2C8\uAC00
      \uC870\uC6A9\uD788 \uC544\uC774\uB97C \uBD88\uB800\uB2E4.\r\n\u201C\uCC3E\uC558\uC5B4.
      \uB4DC\uB514\uC5B4, \uB124 \uD615\uC744\xB7\xB7\xB7!\u201D"
    displayTime: 4
  - illustration: {fileID: 21300000, guid: 345e1fa64f30bfa4594a7343b01a5ce4, type: 3}
    dialogue: "\uADF8\uB54C \uC5B4\uBA38\uB2C8\uB294 \uC544\uC8FC \uD65C\uC9DD, \uB208\uC774
      \uBD80\uC2DC\uB3C4\uB85D \uC6C3\uACE0 \uC788\uC5C8\uB2E4."
    displayTime: 3
  - illustration: {fileID: 21300000, guid: 2172e5f10c6fd8248b48fb8d6c1e41cd, type: 3}
    dialogue: "\u201C\uAE08\uBC29 \uB370\uB824\uC62C\uAC8C.\u201D\uD558\uBA70 \r\n\uC544\uC774\uC758
      \uBA38\uB9AC\uB97C \uC4F0\uB2E4\uB4EC\uC5B4 \uC8FC\uB358 \uC190\uAE38\uC740,\r\n\uCC98\uC74C\uC774\uC790
      \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC544\uC774\uC5D0\uAC8C \uAC74\uB124\uC9C4
      \uB530\uB73B\uD55C \uC628\uAE30\uC600\uB2E4."
    displayTime: 4.5
  - illustration: {fileID: 21300000, guid: 5b3cb43b18f2c1742bfff2623a16c56d, type: 3}
    dialogue: "\uADF8\uB9AC\uACE0\u2014\r\n\uC5B4\uBA38\uB2C8\uB294 \uB3CC\uC544\uC624\uC9C0
      \uC54A\uC558\uB2E4."
    displayTime: 3
  - illustration: {fileID: 21300000, guid: 807b7ee9f63be1d41b8b3a754bd792ac, type: 3}
    dialogue: "\uC5BC\uB9C8 \uC9C0\uB098\uC9C0 \uC54A\uC544, \uC2E0\uC804\uC758 \uC0AC\uB78C\uB4E4\uC774
      \uB2E4\uC2DC \uCC3E\uC544\uC654\uB2E4.\r\n\uC774\uBC88\uC5D0\uB3C4 \uAC19\uC740
      \uB9D0\uC774\uC5C8\uB2E4."
    displayTime: 4
  - illustration: {fileID: 21300000, guid: 807b7ee9f63be1d41b8b3a754bd792ac, type: 3}
    dialogue: "\uC5B4\uBA38\uB2C8\uB3C4 \u2018\uC0C9\u2019\uC744 \uD0D0\uD588\uACE0,\r\n\uADF8
