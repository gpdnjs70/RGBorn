--- !u!114 &1161781219
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1161781217}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 203d3de3967b8904486dd8a62241059a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  imageDisplay: {fileID: 2070562779}
  textDisplay: {fileID: 1150667007}
  cutsceneScenes:
  - illustration: {fileID: 21300000, guid: b3f8f85ad6e90e942b3cbe96f2545850, type: 3}
    dialogue: "\uBA87 \uB144 \uC804,\r\n\uC791\uACE0 \uC870\uC6A9\uD55C \uB9C8\uC744
      \uD55C \uD3B8\uC5D0 \uD55C \uAC00\uC871\uC774 \uC0B4\uACE0 \uC788\uC5C8\uB2E4.\r\n\uC5BC\uB9C8
      \uC804 \uD0DC\uC5B4\uB09C \uC544\uC774\uB85C \uC778\uD574 \uC9D1\uC548\uC5D0\uB294
      \uC6C3\uC74C\uC774 \uB04A\uAE38 \uB0A0\uC774 \uC5C6\uC5C8\uB2E4."
    displayTime: 3
  - illustration: {fileID: 21300000, guid: 7e81b7e5c51dad141a20976c3e82c5af, type: 3}
    dialogue: "\uADF8\uB7EC\uB2E4 \uC5B4\uB290 \uB0A0,\r\n\uD070 \uC544\uC774\uB294
      \uB9C8\uC744 \uADFC\uCC98 \uC2E0\uC804\uC5D0 \uB2E4\uB140\uC624\uACA0\uB2E4\uACE0
      \uD588\uB2E4.\r\n\uB3D9\uC0DD\uC758 \uD589\uBCF5\uC744 \uBE4C\uC5B4\uC8FC\uAE30
      \uC704\uD574 \uAE30\uB3C4\uB9CC \uD558\uACE0 \uAE08\uBC29 \uB3CC\uC544\uC624\uACA0\uB2E4\uB294
      \uB9D0\uACFC \uD568\uAED8."
    displayTime: 3
  - illustration: {fileID: 21300000, guid: f134c590a48d5334d959cebef2a83627, type: 3}
    dialogue: "\uD558\uC9C0\uB9CC\u2014\r\n\uADF8 \uB0A0 \uC774\uD6C4\uB85C,  \uC544\uC774\uB294
      \uB3CC\uC544\uC624\uC9C0 \uC54A\uC558\uB2E4."
    displayTime: 3
  - illustration: {fileID: 21300000, guid: f9c9fd8957487924494df59cd38a04d4, type: 3}
    dialogue: "\uC5B4\uBA38\uB2C8\uB294 \uC9C1\uC811 \uC544\uC774\uB97C \uCC3E\uC544
      \uB098\uC130\uB2E4.\r\n\uC232\uC744 \uB4A4\uC9C0\uACE0,\r\n\uAE38\uC744 \uB530\uB77C\uAC00\uBA70\r\n\uC0AC\uB78C\uB4E4\uC5D0\uAC8C
      \uBB3B\uACE0 \uB610 \uBB3C\uC5C8\uB2E4."
    displayTime: 3
  - illustration: {fileID: 21300000, guid: 6ef3bd5d035d3eb468795151e9cfb67a, type: 3}
    dialogue: "\uD558\uC9C0\uB9CC \uADF8 \uC5B4\uB514\uC5D0\uC11C\uB3C4 \uC544\uC774\uC758
      \uD754\uC801\uC744 \uCC3E\uC744 \uC218 \uC5C6\uC5C8\uB2E4.\r\n\uC5B4\uBA38\uB2C8\uC758
      \uBC1C\uAC78\uC74C\uC740 \uC810\uC810 \uBB34\uAC70\uC6CC\uC84C\uB2E4."
    displayTime: 3
  - illustration: {fileID: 21300000, guid: 16f070fd0e4d89c47b7d5a648b7d249d, type: 3}
    dialogue: "\uADF8\uB7EC\uB2E4 \uC5B4\uB290 \uB0A0, \uC2E0\uC804\uC5D0\uC11C \uC0AC\uB78C\uB4E4\uC774
      \uCC3E\uC544\uC654\uB2E4.\r\n\uADF8\uB4E4\uC740 \uC791\uC740 \uC0C1\uC790 \uD558\uB098\uB97C
      \uB4E4\uACE0 \uC640 \uB9D0\uC744 \uC804\uD588\uB2E4.\r\n\uADF8\uB0A0, \uC2E0\uC804\uC5D0\uC11C\uB294
      \uD070 \uD589\uC0AC\uAC00 \uC788\uC5C8\uACE0\r\n\uC544\uC774\uAC00 \uADF8\uACF3\uC5D0
      \uC788\uC5C8\uB2E4\uACE0 \uD588\uB2E4."
    displayTime: 3
  - illustration: {fileID: 21300000, guid: a173c98cbdd1f61418f5216d4324b8ac, type: 3}
    dialogue: "\uADF8\uB9AC\uACE0\u2026 \uC544\uC774\uAC00 \uC8FC\uAD50\uB97C \uB9C8\uC8FC\uD55C
      \uC21C\uAC04, \u2018\uC0C9\u2019\uC744 \uBCF4\uC600\uB2E4\uACE0 \uD588\uB2E4.\r\n\uC0C9\uC744
      \uD0D0\uD55C \uD0C0\uB77D\uD55C \uC790\uB294 \uC800\uC8FC\uB97C \uBC1B\uB294\uB2E4\uBA70\u2014"
    displayTime: 3
  - illustration: {fileID: 21300000, guid: a173c98cbdd1f61418f5216d4324b8ac, type: 3}
    dialogue: "\uC544\uC774\uB294 \uACB0\uAD6D\r\n\uAD34\uBB3C\uC774 \uB418\uC5B4\uBC84\uB838\uB2E4\uACE0
      \uD588\uB2E4."
    displayTime: 3
  - illustration: {fileID: 21300000, guid: 52ed5aff8d7855947abee3e8fec331c6, type: 3}
    dialogue: "\uADF8\uB798\uC11C \uC5B4\uCA54 \uC218 \uC5C6\uC5C8\uB2E4\uACE0.\r\n\uADF8\uB4E4\uC740
      \uADF8\uB807\uAC8C \uB9D0\uACE0 \uC0C1\uC790\uB97C \uB450\uACE0 \uB3CC\uC544\uAC14\uB2E4."
    displayTime: 3
  - illustration: {fileID: 21300000, guid: 30be2b699798de04da3e24d8f4f4a51a, type: 3}
    dialogue: "\uC5B4\uBA38\uB2C8\uB294 \uD55C\uCC38\uC744 \uADF8 \uC790\uB9AC\uC5D0
      \uC11C \uC788\uC5C8\uB2E4.\r\n\uC0C1\uC790\uB97C \uC5F4\uC9C0\uB3C4 \uBABB\uD55C
      \uCC44,\r\n\uADF8\uC800 \uC190\uC5D0 \uC950\uACE0\uB9CC \uC788\uC5C8\uB2E4."
    displayTime: 3
  - illustration: {fileID: 21300000, guid: 1209f52a2cde1c04c9de5940829ed61b, type: 3}
    dialogue: "\uADF8\uB0A0 \uC774\uD6C4,\r\n\uC5B4\uBA38\uB2C8\uB294 \uB354 \uC774\uC0C1
      \uC6C3\uC9C0 \uC54A\uC558\uB2E4.\r\n\u2019\uC0C9\u2019\uC744 \uC99D\uC624\uD588\uACE0,
      \uC2E0\uC804\uC744 \uC6D0\uB9DD\uD588\uACE0, \uADF8 \uC774\uB984\uC870\uCC28
      \uC785\uC5D0 \uB2F4\uC9C0 \uC54A\uC558\uB2E4.\r\n\uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC740
      \uADF8\uB7F0 \uC5B4\uBA38\uB2C8\uB97C \uC678\uBA74\uD588\uB2E4."
    displayTime: 3
  - illustration: {fileID: 21300000, guid: c7d0ad9a04ac41a4c9599c8c43b2ab4c, type: 3}
    dialogue: "\uADF8\uB807\uAC8C \uBA87 \uB144 \uD6C4, \uC5B4\uB290 \uB0A0.\r\n\uC5B4\uBA38\uB2C8\uAC00
      \uC870\uC6A9\uD788 \uC544\uC774\uB97C \uBD88\uB800\uB2E4.\r\n\u201D\uCC3E\uC558\uC5B4.
      \uB4DC\uB514\uC5B4, \uB124 \uD615\uC744\xB7\xB7\xB7!\u201D"
    displayTime: 3
  - illustration: {fileID: 21300000, guid: c7d0ad9a04ac41a4c9599c8c43b2ab4c, type: 3}
    dialogue: "\uADF8\uB0A0, \uC5B4\uBA38\uB2C8\uB294 \uC6C3\uACE0 \uC788\uC5C8\uB2E4.
      \uC544\uC8FC \uD65C\uC9DD, \uB208\uC774 \uBD80\uC2DC\uB3C4\uB85D..\r\n\u201D\uAE08\uBC29
      \uB370\uB824\uC62C\uAC8C.\u201D\uB77C\uBA70 \uC81C \uBA38\uB9AC\uB97C \uC4F0\uB2E4\uB4EC\uC5B4
      \uC8FC\uB358 \uC190\uAE38\uC740,\r\n\uCC98\uC74C\uC774\uC790 \uB9C8\uC9C0\uB9C9\uC73C\uB85C
      \uC544\uC774\uC5D0\uAC8C \uAC74\uB124\uC9C4 \uB530\uB73B\uD55C \uC628\uAE30\uC600\uB2E4."
    displayTime: 3
  - illustration: {fileID: 21300000, guid: 36d7acfa896b46c4abb9701e09999138, type: 3}
    dialogue: "\uADF8\uB9AC\uACE0\u2014 \uC5B4\uBA38\uB2C8\uB294 \uB3CC\uC544\uC624\uC9C0
      \uC54A\uC558\uB2E4.\r\n\uC5BC\uB9C8 \uC9C0\uB098\uC9C0 \uC54A\uC544, \uC2E0\uC804\uC758
      \uC0AC\uB78C\uB4E4\uC774 \uB2E4\uC2DC \uCC3E\uC544\uC654\uB2E4.\r\n\uC774\uBC88\uC5D0\uB3C4
      \uAC19\uC740 \uB9D0\uC774\uC5C8\uB2E4."
    displayTime: 3
  - illustration: {fileID: 21300000, guid: 36d7acfa896b46c4abb9701e09999138, type: 3}
    dialogue: "\uC5B4\uBA38\uB2C8\uB3C4 \u2018\uC0C9\u2019\uC744 \uD0D0\uD588\uACE0,
      \uADF8 \uACB0\uACFC \uC800\uC8FC\uB97C \uBC1B\uC544 \uAD34\uBB3C\uC774 \uB418\uC5C8\uB2E4\uACE0.\r\n\uADF8\uB798\uC11C
      \uC774\uBC88\uC5D0\uB3C4 \uC5B4\uCA54 \uC218 \uC5C6\uC5C8\uB2E4\uACE0\u2026\r\n\uADF8\uB4E4\uC740
      \uB610 \uD558\uB098\uC758 \uC0C1\uC790\uB97C \uB450\uACE0 \uB3CC\uC544\uAC14\uB2E4."
    displayTime: 3
  - illustration: {fileID: 21300000, guid: 36d7acfa896b46c4abb9701e09999138, type: 3}
    dialogue: "\uD558\uC9C0\uB9CC \uC5B4\uBA38\uB2C8\uB294\u2014"
    displayTime: 3
  nextSceneName: Tutorial_Inside
